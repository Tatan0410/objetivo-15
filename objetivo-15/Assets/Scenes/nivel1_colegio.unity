      propertyPath: alturaBurbuja
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: tamanioFuente
      value: 28
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: cooldownReaparicion
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[0].texto
      value: "!Hola, joven!\n Me alegra que quieras aprender\n sobre el ODS 15.\n
        Yo soy Ambientalin."
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[2].texto
      value: "Sigue el camino y recolecta\n plasticos. Cada uno te\n ense\xF1ara
        algo nuevo\n sobre como cuidar\n nuestro planeta."
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[3].texto
      value: "\xBFA que te refieres con\n recolectar plasticos?\n\xBFdices que si
        lo hago obtendre \nalguna recompensa?"
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[4].texto
      value: "Me alegra que preguntes, cada\nplastico que recolectes ayudar\xE1 a\nmejorar
        las condiciones del \nmunicipio, adem\xE1s reciclando \npodras hacer armamento
        con el\nque podr\xE1s superar el juego"
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[5].texto
      value: Si lo dices de esa manera... ME APUNTO
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[6].texto
      value: "Esa es la actitud joven \n\xA1VE Y SALVA A SOLEDAD!"
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[3].esJugador
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[5].esJugador
