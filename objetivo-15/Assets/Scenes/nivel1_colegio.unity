    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: fontAsset
      value: 
      objectReference: {fileID: 11400000, guid: 1468e9736dcd81348a51f8e3df798a47, type: 2}
