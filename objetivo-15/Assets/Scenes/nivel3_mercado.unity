--- !u!1001 &1284417269
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 5104073181026472674, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: m_Name
      value: NPC_Ambientalin
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[0].texto
      value: "\xA1Cuidado por d\xF3nde pisas! \nEst\xE1s entrando al \xE1rea del
        mercado\n y los barrios perif\xE9ricos."
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[1].texto
      value: "\xA1Uf! Hay bolsas, cajas, pl\xE1stico y\n escombros tirados por todas
        partes.\n \xBFAcaso no hay\n recolecci\xF3n de basura aqu\xED?\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[2].texto
      value: "El problema central es el\n manejo inadecuado de los\n residuos s\xF3lidos. "
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[3].texto
      value: "Diariamente se generan\n toneladas de desechos que\n se arrojan de
        forma incorrecta\n en esquinas, lotes destapados y\n en las orillas de los
        arroyos.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[4].texto
      value: "\xBFY qu\xE9 pasa cuando la\nbasura se acumula por d\xEDas\n en la
        calle?"
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[5].texto
      value: "Se forman basureros a cielo\n abierto que destruyen el\n paisaje del
        sector y bloquean\n los cauces de agua.\n "
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[6].texto
      value: "Adem\xE1s, cuando llueve, todo\n este material es arrastrado\n provocando
        emergencias\n a\xFAn mayores.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[3].esJugador
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[4].esJugador
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5415706260632634918, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: dialogos.Array.data[5].esJugador
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7392805380021571251, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: m_LocalPosition.x
      value: -18.252975
      objectReference: {fileID: 0}
    - target: {fileID: 7392805380021571251, guid: fbe5dc7bb912fbb4189bfbf716073ae1, type: 3}
      propertyPath: m_LocalPosition.y
